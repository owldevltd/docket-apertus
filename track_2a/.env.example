# Copy to .env and fill in. The pipeline reads these from the environment; Docker passes them with --env-file .env.

# OpenAI-compatible endpoint that serves Apertus, and the key for it.
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=

# Shipped documents and the working folder; the defaults are the project folders.
# DATA_DIR=./data
# STORAGE_DIR=./storage

# The store: Postgres when set (make run sets it for the container), else files under STORAGE_DIR/store.
# DATABASE_URL=postgresql://docket:docket@localhost:5432/docket

# The web server (python -m docket serve). The administration (/admin in the app: the review, the decisions,
# the runs, the rules, the vocabulary) has one account. With ADMIN_PASSWORD set, it is entered by signing in
# with ADMIN_USER and that password, and every decision carries the name of the account; without a password
# the administration is open, for a local run. What a visitor reads needs no account either way.
# PORT=8080
# ADMIN_USER=admin
# ADMIN_PASSWORD=
