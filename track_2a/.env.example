# Copy to .env and fill in. The pipeline reads these from the environment; Docker passes them with --env-file .env.

# OpenAI-compatible endpoint that serves Apertus, and the key for it.
MODEL=swiss-ai/Apertus-v1.5-8B
BASE_URL=https://api.inference.cscs.ch/v1
API_KEY=

# Shipped documents and the working folder; the defaults are the project folders.
# DATA_DIR=./data
# STORAGE_DIR=./storage
