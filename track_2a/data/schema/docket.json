        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "approve": {
          "type": "boolean",
          "description": "a person should look"
        },
        "isOCR": {
          "type": "boolean",
          "description": "the text comes from text recognition, not from the PDF itself"
        },
        "sec-type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/body"
        },
        "font": {
          "type": "string",
          "description": "the font as the PDF names it; only with a text layer"
        },
        "font-size": {
          "type": "number",
          "description": "font size in points"
        },
        "color": {
          "type": "string",
          "description": "text colour as #rrggbb"
        }
      },
      "additionalProperties": false
    },
    "p": {
      "type": "object",
