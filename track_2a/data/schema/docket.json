{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parliamentary affair: OpenParlData with the document's build-up after JATS",
  "description": "Version 0.8. The OpenParlData API's answer for an affair stays unchanged and unchecked; described is only what is added. New keys are named like the element in JATS 1.3 Archiving. dynamic: true marks everything that was added later.",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "0.8"
    },
    "custom-meta": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "a printed header entry without a place of its own at OpenParlData",
        "required": [
          "meta-name",
          "meta-value"
        ],
        "properties": {
          "meta-name": {
            "type": "string"
          },
          "meta-value": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "additionalProperties": false
      }
    },
    "related-article": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "a related affair",
        "properties": {
          "affair_id": {
            "type": "integer"
          },
          "number": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "additionalProperties": false
      }
    },
    "related-object": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "a reference to something that is not an affair",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "additionalProperties": false
      },
      "dynamic": true
    },
    "kwd-group": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "dynamic": true
    },
    "docs": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc"
          }
        }
      }
    },
    "contributors": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contributor"
          }
        }
      }
    },
    "events": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "places in the document for values whose own place carries no source (number, title, type_name, begin_date, article-version, article-type, abstract, kwd-group); path is the way to the value, with dots",
      "items": {
        "type": "object",
        "required": [
          "path",
          "doc",
          "block"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "doc": {
            "type": "integer"
          },
          "block": {
            "type": "string"
          },
          "how": {
            "type": "string",
            "enum": [
              "literal",
              "derived",
              "cited",
              "composed"
            ]
          },
          "approve": {
            "type": "boolean"
          },
          "review": {
            "$ref": "#/$defs/review"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "description": "where a value came from in the document",
      "required": [
        "doc",
        "block"
      ],
      "properties": {
        "doc": {
          "type": "integer",
          "description": "the document (docs.id)"
        },
        "block": {
          "type": "string",
          "description": "id of a block in that document"
        },
        "how": {
          "type": "string",
          "enum": [
            "literal",
            "derived",
            "cited",
            "composed"
          ],
          "description": "how the value got its place: literal (found in the block as is), derived (every word of the value stands in the block, put together differently), cited (the model named the block), composed (the model phrased it)"
        },
        "approve": {
          "type": "boolean",
          "description": "a person should look: not found literally, or the block itself carries approve"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "description": "text per language, as OpenParlData has it",
      "additionalProperties": {
        "type": "string"
      }
    },
    "doc": {
      "type": "object",
      "properties": {
        "page-count": {
          "type": "integer"
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "response": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "an answer within the same document",
            "required": [
              "body"
            ],
            "properties": {
              "response-type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "$ref": "#/$defs/body"
              }
            },
            "additionalProperties": false
          }
        },
        "back": {
          "$ref": "#/$defs/back",
          "dynamic": true
        },
        "article-version": {
          "type": "string",
          "description": "the version, as printed",
          "dynamic": true
        },
        "article-type": {
          "type": "string",
          "dynamic": true,
          "description": "the kind of the document in the affair, from data/knowledge/kinds.json: submission, answer, bill, minutes, committee-report, act, attachment; set by the rule from the words of the first page, absent when none of them stands there; its place is in the root sources"
        },
        "abstract": {
          "$ref": "#/$defs/languages",
          "dynamic": true
        },
        "conference": {
          "type": "object",
          "description": "the session or meeting the document names",
          "properties": {
            "conf-name": {
              "type": "string"
            },
            "conf-date": {
              "type": "string"
            },
            "conf-loc": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          },
          "additionalProperties": false,
          "dynamic": true
        },
        "journal-meta": {
          "type": "object",
          "description": "press and periodicals only",
          "properties": {
            "journal-title": {
              "type": "string"
            },
            "publisher-name": {
              "type": "string"
            },
            "issn": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          },
          "additionalProperties": false,
          "dynamic": true
        },
        "volume": {
          "type": "string",
          "dynamic": true
        },
        "issue": {
          "type": "string",
          "dynamic": true
        },
        "fpage": {
          "type": "string",
          "dynamic": true
        },
        "lpage": {
          "type": "string",
          "dynamic": true
        }
      }
    },
    "contributor": {
      "type": "object",
      "properties": {
        "degrees": {
          "type": "string",
          "dynamic": true
        },
        "aff": {
          "type": "string",
          "dynamic": true
        },
        "on-behalf-of": {
          "type": "string",
          "dynamic": true
        },
        "address": {
          "type": "string",
          "dynamic": true
        },
        "email": {
          "type": "string",
          "dynamic": true
        },
        "author-comment": {
          "type": "string",
          "dynamic": true
        },
        "etal": {
          "type": "boolean",
          "dynamic": true
        }
      }
    },
    "event": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "body": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/sec"
          },
          {
            "$ref": "#/$defs/p"
          },
          {
            "$ref": "#/$defs/list"
          },
          {
            "$ref": "#/$defs/def-list"
          },
          {
            "$ref": "#/$defs/table-wrap"
          },
          {
            "$ref": "#/$defs/graphic"
          },
          {
            "$ref": "#/$defs/sig-block"
          }
        ]
      }
    },
    "back": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/sec"
          },
          {
            "$ref": "#/$defs/p"
          },
          {
            "$ref": "#/$defs/list"
          },
          {
            "$ref": "#/$defs/def-list"
          },
          {
            "$ref": "#/$defs/table-wrap"
          },
          {
            "$ref": "#/$defs/graphic"
          },
          {
            "$ref": "#/$defs/app"
          },
          {
            "$ref": "#/$defs/fn"
          },
          {
            "$ref": "#/$defs/ref-list"
          },
          {
            "$ref": "#/$defs/notes"
          }
        ]
      }
    },
    "sec": {
      "type": "object",
      "description": "a section with a heading",
      "required": [
        "id",
