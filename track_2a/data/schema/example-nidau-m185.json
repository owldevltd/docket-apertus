                "color": "#000000",
                "text": "Beschluss. Gemeinderat: Aktenzeichen: Ressort: Antrag Gemeinderat:"
              },
              {
                "id": "b12",
                "page": 1,
                "type": "p",
                "x": 938,
                "y": 1228,
