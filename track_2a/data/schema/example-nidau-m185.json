                "isOCR": false,
                "font": "Verdana",
                "font-size": 8,
                "color": "#000000",
                "text": "18.02.2019 nid 0.1.6.2 / 2 Präsidiales Ablehnung"
              },
              {
                "id": "b13",
                "page": 1,
                "type": "p",
                "x": 408,
                "y": 1530,
